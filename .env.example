# Copy this file to .env to configure real LLM generation.
# Real generation is now the DEFAULT behavior when a request omits the
# `response` field — the app calls out to whichever provider is
# configured below. Not copying this file at all is fine too: it just
# means the defaults (LLM_PROVIDER=ollama, model=llama3.2, localhost
# Ollama) apply. Never commit a real .env file — it is gitignored.

# --- Database (defaults to local SQLite; swap for Postgres if needed) ---
DATABASE_URL=sqlite:///./controlplane.db

# --- LLM provider: "ollama" (local, no key, no internet — safer for a
# live demo) or "gemini" (needs an API key + internet, higher quality) ---
LLM_PROVIDER=ollama

# --- Ollama settings (used when LLM_PROVIDER=ollama) ---
# Run `ollama serve` and `ollama pull llama3.2` before starting the app.
# Docker connects to this host address by default.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Optional hallucination second opinion ---
# Enabled by default when a provider is configured; set false to keep only
# informational claim candidates during an offline demo.
HALLUCINATION_LLM_JUDGE_ENABLED=true

# --- Gemini settings (used when LLM_PROVIDER=gemini) ---
# Get a key at https://aistudio.google.com/apikey — never commit it.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
